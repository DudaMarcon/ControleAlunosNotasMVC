@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="text-center mb-4">Acessar Sistema</h2>

                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        @TempData["Sucesso"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label class="control-label">E-mail</label>
                        <input type="email" name="email" class="form-control" placeholder="seu-email@exemplo.com" required />
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label">Senha</label>
                        <input type="password" name="senha" class="form-control" placeholder="Sua senha" required />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Cadastro" class="text-decoration-none">Não tem uma conta? Cadastre-se</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>