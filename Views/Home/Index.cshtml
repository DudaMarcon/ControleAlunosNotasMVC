@{
    ViewData["Title"] = "Página Inicial";
}

<div class="text-center mb-5">
    <h1 class="display-4">Sistema de Gestão Escolar</h1>
    <p class="lead text-muted">Gerencie alunos, turmas e notas de forma simples e eficiente.</p>
</div>

<!-- Cards de Atalhos / Funcionalidades -->
<!-- Adicionamos justify-content-center aqui na row -->
<div class="row text-center justify-content-center">
    
    <!-- Card de Alunos (Mudou de col-md-4 para col-md-5) -->
    <div class="col-md-5 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-3">
                        <i class="bi bi-people-fill text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h3 class="card-title h5">Alunos</h3>
                    <p class="card-text text-muted">Cadastre, edite e visualize os dados dos estudantes matriculados.</p>
                </div>
                <div class="mt-3">
                    <a class="btn btn-primary w-100" asp-controller="Aluno" asp-action="Index">
                        Gerenciar Alunos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Notas (Mudou de col-md-4 para col-md-5) -->
    <div class="col-md-5 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-3">
                        <i class="bi bi-journal-check text-success" style="font-size: 2.5rem;"></i>
                    </div>
                    <h3 class="card-title h5">Notas e Boletins</h3>
                    <p class="card-text text-muted">Lance notas, acompanhe o desempenho e consulte boletins.</p>
                </div>
                <div class="mt-3">
                    <a class="btn btn-success w-100" asp-controller="Aluno" asp-action="CriarNota">
                        Lançar Notas
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
    <!-- Relatórios / Turmas (Opcional) -->

@section Scripts {
    <!-- Opcional: Caso queira usar ícones do Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
