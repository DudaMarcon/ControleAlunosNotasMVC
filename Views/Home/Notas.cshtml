@{
    ViewData["Title"] = "Home Page";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Notas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="text-center">Sistema de Notas dos Alunos</h3>
            </div>

            <div class="card-body">
                <form>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Nome do Aluno</label>
                            <input type="text" class="form-control" placeholder="Digite o nome do aluno">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">RM</label>
                            <input type="text" class="form-control" placeholder="Digite o RM">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Turma</label>
                            <input type="text" class="form-control" placeholder="Digite a turma">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Curso</label>
                            <input type="text" class="form-control" placeholder="Digite o curso">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Matéria</label>
                            <input type="text" class="form-control" placeholder="Digite a matéria">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Nome do Professor</label>
                            <input type="text" class="form-control" placeholder="Digite o nome do professor">
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label class="form-label">Nota</label>
                            <input type="number" step="0.1" class="form-control" placeholder="Digite a nota">
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            Salvar
                        </button>

                        <button type="reset" class="btn btn-secondary">
                            Limpar
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
