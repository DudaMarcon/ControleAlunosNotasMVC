<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Controle de Alunos e Notas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sistema_notaAluno.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Controle de Alunos e Notas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="aluno" asp-action="Index">Alunos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="aluno" asp-action="CriarNota">Notas</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
                        @{
                            var httpContext = HttpContextAccessor.HttpContext;
                            string usuarioLogado = httpContext?.Session?.GetString("UsuarioLogado") ?? string.Empty;
                            string tipoUsuario = httpContext?.Session?.GetString("TipoUsuario") ?? string.Empty;
                        }

                        @if (!string.IsNullOrEmpty(usuarioLogado))
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link fw-bold">
                                    Olá, @usuarioLogado
                                    <span class="badge bg-secondary ms-1">@tipoUsuario</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Conta" asp-action="Logout">Sair</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Conta" asp-action="Login">Entrar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Conta" asp-action="Cadastro">Cadastrar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-white text-muted py-4 mt-auto shadow-sm">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="text-dark fw-bold mb-2">Sistema Escolar</h5>
                    <p class="small text-muted mb-0">
                        Plataforma desenvolvida em ASP.NET Core MVC para o gerenciamento eficiente de alunos e notas acadêmicas.
                    </p>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h6 class="text-dark fw-bold mb-2">Navegação Rápida</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1">
                            <a class="text-decoration-none text-muted" asp-controller="Home" asp-action="Index">Página Inicial</a>
                        </li>
                        <li class="mb-1">
                            <a class="text-decoration-none text-muted" asp-controller="Aluno" asp-action="Index">Gerenciar Alunos</a>
                        </li>
                        <li class="mb-1">
                            <a class="text-decoration-none text-muted" asp-controller="Aluno" asp-action="CriarNota">Lançar Notas</a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-dark fw-bold mb-2">Tecnologias</h6>
                    <p class="small text-muted mb-1">
                        <i class="bi bi-code-slash text-primary"></i> C# / .NET Core MVC & Bootstrap
                    </p>
                    <p class="small text-muted mb-0">
                        <i class="bi bi-database text-success"></i> SQLite / Entity Framework Core
                    </p>
                </div>
            </div>
            <hr class="my-3 text-secondary opacity-25">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start small">
                    &copy; 2026 - ControleAlunosNotasMVC. Todos os direitos reservados.
                </div>
                <div class="col-md-6 text-center text-md-end small text-muted">
                    Desenvolvido para fins acadêmicos 🎓
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>