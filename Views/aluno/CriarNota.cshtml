@model Sistema_notaAluno.ViewModels.CriarNotaViewModel

@{
    ViewData["Title"] = "Cadastrar Nota";
}

<h1>Cadastrar Nota</h1>

<form asp-action="CriarNota" method="post">

    <div class="mb-3">
        <label asp-for="AlunoId" class="form-label">Aluno</label>

        <select asp-for="AlunoId" class="form-select">
            <option value="">Selecione o aluno</option>

            @foreach (var aluno in ViewBag.Alunos)
            {
                <option value="@aluno.Id">
                    @aluno.Nome - @aluno.Turma
                </option>
            }
        </select>

        <span asp-validation-for="AlunoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Disciplina" class="form-label">Disciplina</label>
        <input asp-for="Disciplina" class="form-control" />
        <span asp-validation-for="Disciplina" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nota1" class="form-label">Nota 1</label>
        <input asp-for="Nota1" class="form-control" type="number" step="0.1" min="0" max="10" />
        <span asp-validation-for="Nota1" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nota2" class="form-label">Nota 2</label>
        <input asp-for="Nota2" class="form-control" type="number" step="0.1" min="0" max="10" />
        <span asp-validation-for="Nota2" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Cadastrar Nota
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}