
@model List<Sistema_notaAluno.Models.Aluno>

@{
    ViewData["Title"] = "Sistema de alunos";
}

<h1>@ViewData["Title"]</h1>

<a asp-action="Criar" class="btn btn-primary mb-3">
    Cadastrar Aluno
</a>

<!-- Formulário de busca e filtros -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Buscar e filtrar alunos</h5>
    </div>

    <div class="card-body">
        <form asp-controller="Aluno" asp-action="Index" method="get">
            <div class="row g-3">

                <div class="col-md-6">
                    <label for="busca" class="form-label">
                        Nome ou matrícula
                    </label>
                    <input type="text"
                           id="busca"
                           name="busca"
                           value="@ViewBag.Busca"
                           class="form-control"
                           placeholder="Digite o nome ou a matrícula" />
                </div>

                <div class="col-md-6">
                    <label for="turma" class="form-label">
                        Turma
                    </label>
                    <select id="turma" name="turma" class="form-select">
                        <option value="">Todas as turmas</option>
                        @foreach (var item in ViewBag.Turmas)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Turma == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="curso" class="form-label">
                        Curso
                    </label>
                    <select id="curso" name="curso" class="form-select">
                        <option value="">Todos os cursos</option>
                        @foreach (var item in ViewBag.Cursos)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Curso == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="status" class="form-label">
                        Status
                    </label>
                    <select id="status" name="status" class="form-select">
                        <option value="">Todos os status</option>
                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Status == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Buscar e filtrar
                </button>

                <a asp-controller="Aluno"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Limpar filtros
                </a>
            </div>
        </form>
    </div>
</div>

<p>Alunos encontrados: @Model.Count</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Turma</th>
            <th>Curso</th>
            <th>Status</th>
            <th>Matrícula</th>
            <th>Boletim</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Count > 0)
        {
            @foreach (var aluno in Model)
            {
                <tr>
                    <td>@aluno.Id</td>
                    <td>@aluno.Nome</td>
                    <td>@aluno.Turma</td>
                    <td>@aluno.Curso</td>
                    <td>@aluno.Status</td>
                    <td>@aluno.Matricula</td>
                    <td>
                        <a asp-controller="Aluno"
                           asp-action="Detalhes"
                           asp-route-id="@aluno.Id"
                           class="btn btn-primary btn-sm">
                            Ver Boletim
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    Nenhum aluno encontrado com os critérios informados.
                </td>
            </tr>
        }
    </tbody>
</table>
