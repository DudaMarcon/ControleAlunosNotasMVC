@model Sistema_notaAluno.Models.Aluno

@{
    ViewData["Title"] = "Boletim Escolar";
}

<div class="container mt-4">

    <h2>Boletim do Aluno</h2>

    <div class="card mb-4">

        <div class="card-header bg-primary text-white">
            Dados do Aluno
        </div>

        <div class="card-body">

            <p><strong>Nome:</strong> @Model.Nome</p>

            <p><strong>Turma:</strong> @Model.Turma</p>

            <p><strong>Curso:</strong> @Model.Curso</p>

            <p><strong>Status:</strong> @Model.Status</p>

            <p><strong>Matr�cula:</strong> @Model.Matricula</p>

        </div>
    </div>

    <div class="card">

        <div class="card-header bg-success text-white">
            Notas
        </div>

        <div class="card-body">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Disciplina</th>
                        <th>Nota 1</th>
                        <th>Nota 2</th>
                        <th>M�dia</th>
                        <th>Situa��o</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var nota in Model.Notas)
                    {
                    <tr>
                        <td>@nota.Disciplina</td>

                        <td>@nota.Nota1</td>

                        <td>@nota.Nota2</td>

                        <td>@nota.Media</td>

                        <td>
                            @if (nota.Media >= 6)
                                {
                            <span class="badge bg-success">
                                Aprovado
                            </span>
                                }
                                else
                                {
                            <span class="badge bg-danger">
                                Reprovado
                            </span>
                                }
                        </td>
                    </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <br>

    <div class="card-footer">

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>